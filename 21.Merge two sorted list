class Solution:
    def mergeTwoLists(self, list1: Optional[ListNode], list2: Optional[ListNode]) -> Optional[ListNode]:
        dummyNode = ListNode(-1)
        temp = dummyNode
        temp1 = list1 
        temp2 = list2
        while temp1  and temp2:
            if temp1.val <= temp2.val:
                temp.next = temp1
                temp = temp1
                temp1 = temp1.next
            else:
                temp.next = temp2
                temp = temp2
                temp2 = temp2.next
        if temp1:
            temp.next = temp1
        else:
            temp.next = temp2
        return dummyNode.next
