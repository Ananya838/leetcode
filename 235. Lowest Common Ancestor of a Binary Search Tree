# Definition for a binary tree node.
# class TreeNode:
#     def __init__(self, x):
#         self.val = x
#         self.left = None
#         self.right = None

class Solution:
    def lowestCommonAncestor(self, root: 'TreeNode', p: 'TreeNode', q: 'TreeNode') -> 'TreeNode':
        def LCA(root,p,q):
            if p.val<root.val and q.val<root.val:
                return LCA(root.left,p,q)
            if  p.val>root.val and q.val>root.val:
                return LCA(root.right,p,q)
            return root
        return LCA(root,p,q)
