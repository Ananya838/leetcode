class Solution:
    def rightSideView(
        self, root: Optional[TreeNode]
    ) -> List[int]:

        # If there is no tree, there is nothing to see.
        if not root:
            return []

        # BFS uses a queue because we want to process
        # the tree LEVEL BY LEVEL.
        ans = []
        queue = deque([root])

        while queue:

            # IMPORTANT:
            # Capture the number of nodes currently in the queue.
            #
            # These nodes belong to the SAME level.
            #
            # Example:
            #
            #       1
            #      / \
            #     2   3
            #
            # When processing level 1:
            # queue = [2, 3]
            # level_size = 2
            #
            # We must process exactly these 2 nodes.
            level_size = len(queue)

            # Process all nodes belonging to this level.
            # i tells us the position of the node inside this level.
            #
            # Example:
            # level = [2, 3]
            #
            # i = 0 → node 2
            # i = 1 → node 3
            #
            # Since we process LEFT → RIGHT,
            # the LAST node is the RIGHTMOST node.
            for i in range(level_size):

                node = queue.popleft()

                # If this is the LAST node of the current level,
                # it is the node we would see from the RIGHT side.
                #
                # Example:
                #
                #       1
                #      / \
                #     2   3
                #
                # At this level:
                #
                # i = 0 → 2
                # i = 1 → 3 ← LAST → visible from right
                if i == level_size - 1:
                    ans.append(node.val)

                # We still add BOTH children.
                #
                # Why?
                #
                # Even though we only care about the rightmost
                # node for the answer, the children of ALL nodes
                # may become visible at the next level.
                #
                # Example:
                #
                #       1
                #      / \
                #     2   3
                #      \   \
                #       5   4
                #
                # We cannot ignore node 2 just because 3 is
                # currently visible.
                #
                # Node 2 has child 5, which may matter later.
                if node.left:
                    queue.append(node.left)

                if node.right:
                    queue.append(node.right)

        return ans
