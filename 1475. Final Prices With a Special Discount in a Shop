class Solution:
    def finalPrices(self, prices: List[int]) -> List[int]:
        stack = []
        res = prices[:]
        for i in range(len(prices)):
            while stack and stack[-1][0]>=prices[i]:
                prev_val,prev_idx = stack.pop()
                res[prev_idx] = prev_val - prices[i]
            stack.append((prices[i],i))
        return res
