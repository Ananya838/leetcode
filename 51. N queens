class Solution:
    def solveNQueens(self, n: int) -> List[List[str]]:
        res = []
        cols = set()
        diagonal1 = set()
        diagonal2 = set()
        board = [['.']*n for _  in range(n)]
        def backtrack(row):
            if row == n:
                copy = ["".join(r) for r in board]
                res.append(copy)
                return
            for col in range(n):

                # checking whether queen can be placed
                if col in cols or (row-col) in diagonal1 or (row+col) in diagonal2:
                    continue

                cols.add(col)
                diagonal1.add(row-col)
                diagonal2.add(row+col)

                board[row][col] = "Q"

                 # move to next row
                backtrack(row+1)

                 # remove queen (backtracking)
                cols.remove(col)
                diagonal1.remove(row-col)
                diagonal2.remove(row+col)

                board[row][col] = "."

        backtrack(0)
        return res
