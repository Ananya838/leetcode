class Solution:
    def rotate(self, nums: list[int], k: int) -> None:
        n = len(nums)
        k %= n

        def reverse(i,j):
            while i<=j:
                nums[i],nums[j] = nums[j],nums[i]
                i+=1
                j-=1
        reverse(0,n-1)
        reverse(0,k-1)
        reverse(k,n-1)
        return nums


class Solution:
    def rotate(self, nums: List[int], k: int) -> None:
        k %= len(nums)
        nums[:] = nums[len(nums)-k:] + nums[:len(nums)-k]
        
