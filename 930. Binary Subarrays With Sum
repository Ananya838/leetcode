### pattern3- hashmap+prefixsum   
class Solution:
    def numSubarraysWithSum(self, nums: List[int], goal: int) -> int:
        prefix = {0:1}
        count = 0
        prefixsum = 0
        for num in nums:
            prefixsum += num

            needed = prefixsum - goal
            if needed in prefix:
                count+=prefix[needed]
            prefix[prefixsum] = prefix.get(prefixsum,0)+1
        return count


            
        
