class Solution:
    def isSubsetSum(self, arr: list[int], sum: int) -> bool:
        dp = [False] * (sum + 1)
        dp[0] = True  # A sum of 0 is always possible (empty subset)

        for num in arr:
            # Iterate backwards so we don't reuse the same number in the same step
            for j in range(sum, num - 1, -1):
                if dp[j - num]:
                    dp[j] = True

        return dp[sum]
            
