class Solution:
    def removeDuplicateLetters(self, s: str) -> str:
        stack = []
        hashmap = {}
        for ch in s:
            hashmap[ch] = hashmap.get(ch,0)+1
        
        seen = set()
        for ch in s:
            hashmap[ch]-=1
            if ch in seen:
                continue
            while stack and stack[-1]>ch and hashmap[stack[-1]]>0:
                seen.remove(stack.pop())
            stack.append(ch)
            seen.add(ch)

        return "".join(stack)

        

        
