import heapq
from collections import defaultdict

class Twitter:

    def __init__(self):
        self.time = 0
        self.tweetMap = defaultdict(list)   # userId -> list of (time, tweetId)
        self.followMap = defaultdict(set)   # userId -> set of followees

    def postTweet(self, userId: int, tweetId: int) -> None:
        self.tweetMap[userId].append((self.time, tweetId))
        self.time += 1

    def follow(self, followerId: int, followeeId: int) -> None:
        self.followMap[followerId].add(followeeId)

    def unfollow(self, followerId: int, followeeId: int) -> None:
        if followeeId in self.followMap[followerId] and followeeId != followerId:
            self.followMap[followerId].remove(followeeId)

    def getNewsFeed(self, userId: int):
        res = []
        maxHeap = []

        # user should follow themselves
        self.followMap[userId].add(userId)

        for followee in self.followMap[userId]:
            if followee in self.tweetMap:
                index = len(self.tweetMap[followee]) - 1
                time, tweetId = self.tweetMap[followee][index]
                heapq.heappush(maxHeap, (-time, tweetId, followee, index - 1))

        while maxHeap and len(res) < 10:
            time, tweetId, user, index = heapq.heappop(maxHeap)
            res.append(tweetId)

            if index >= 0:
                nextTime, nextTweetId = self.tweetMap[user][index]
                heapq.heappush(maxHeap, (-nextTime, nextTweetId, user, index - 1))

        return res
