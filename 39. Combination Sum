class Solution:
    def combinationSum(self, candidates: list[int], target: int) -> list[list[int]]:
        result = []
        path = []

        def backtrack(start, sum_path):

            # SUCCESS: target reached
            if sum_path == target:
                result.append(path.copy())
                return

            # PRUNING: we crossed the target
            if sum_path > target:
                return

            # Try every candidate from 'start' onwards
            for i in range(start, len(candidates)):

                # CHOOSE
                path.append(candidates[i])
                sum_path += candidates[i]

                # EXPLORE
                # We pass i, not i + 1,
                # because the same candidate can be reused.
                # But start prevents us from going backward.
                backtrack(i, sum_path)

                # UNDO / BACKTRACK
                path.pop()
                sum_path -= candidates[i]

        # Start with no elements selected and sum = 0
        backtrack(0, 0)





