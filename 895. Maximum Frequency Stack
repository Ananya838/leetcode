class FreqStack:

    def __init__(self):
        # Stores the frequency of each value.
        # Example:
        # {5:3, 7:2, 4:1}
        self.freq = {}

        # Stores a stack for each frequency.
        # Example:
        # {
        #   1: [5,7,4],
        #   2: [5,7],
        #   3: [5]
        # }
        self.group = {}

        # Stores the current maximum frequency.
        self.maxFreq = 0

    def push(self, val: int) -> None:

        # Increase the frequency of val.
        self.freq[val] = self.freq.get(val, 0) + 1

        # Current frequency of val.
        f = self.freq[val]

        # Update maximum frequency.
        self.maxFreq = max(self.maxFreq, f)

        # If this frequency doesn't have a stack yet,
        # create one.
        if f not in self.group:
            self.group[f] = []

        # Push the value into the stack
        # corresponding to its frequency.
        self.group[f].append(val)

    def pop(self) -> int:

        # Remove the most recent element
        # having the maximum frequency.
        val = self.group[self.maxFreq].pop()

        # Decrease its frequency.
        self.freq[val] -= 1

        # If no elements remain with this frequency,
        # decrease maxFreq.
        if not self.group[self.maxFreq]:
            self.maxFreq -= 1

        return val
