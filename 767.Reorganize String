class Solution:
    def reorganizeString(self, s: str) -> str:
        freq = Counter(s)

         # Check if rearrangement is possible
        if max(freq.values()) > (len(s)+1)/2: 
            return ""

        # Max heap using negative frequency
        heap = [(-count,char) for char , count in freq.items()]
        heapq.heapify(heap)

        result = []
        prev_count = 0
        prev_char = 0

        while heap:
            ##count in heap stored as negative value to h=return highest frequency so that's why we make count+=1 in after append char to result.
            count , char = heapq.heappop(heap)

            result.append(char)

           # One character is used
            count+=1

             # Previous character can now be reused
            if prev_count < 0:
                heapq.heappush(heap,(prev_count,prev_char))

            prev_count = count
            prev_char = char


        return "".join(result)
