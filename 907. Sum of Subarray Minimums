class Solution:
    def sumSubarrayMins(self, arr: List[int]) -> int:
        n = len(arr)
        stack = []
        pse = [-1]*n
        ###previous smaller elemnt
        for i in range(n):
            while stack and arr[stack[-1]]>=arr[i]:
                stack.pop()
            if stack:
                pse[i] = stack[-1]
            stack.append(i)
        ######Next samller elemnt
        stack = []
        nse = [n]*n
        for i in range(n-1,-1,-1):
            while stack and arr[stack[-1]]>arr[i]:
                stack.pop()
            if stack:
                nse[i] = stack[-1]
            stack.append(i)

       ####main logic of the idea 
        value = 0
        MOD = 10**9+7
        for i in range(n):
            left = i - pse[i]
            right = nse[i] - i
            value = (value + arr[i]*left*right)%MOD
        return value
