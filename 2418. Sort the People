class Solution:
    def sortPeople(self, names: List[str], heights: List[int]) -> List[str]:
        ans = {}
        for i in range(len(names)):
            ans[heights[i]] = names[i]
        heights.sort()
        ans1 = []
        for i in range(len(heights)-1,-1,-1):
            ans1.append(ans[heights[i]])
        return ans1
