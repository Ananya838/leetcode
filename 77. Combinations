class Solution:
    def combine(self, n: int, k: int) -> List[List[int]]:
        res = []
        path = []
        def backtrack(start):
            if len(path)==k:
                res.append(path[:])
                return res
            for i in range(start,n+1):
                path.append(i) #choose
                backtrack(i+1) #explore
                path.pop()     #undo
        backtrack(1)
        return res
