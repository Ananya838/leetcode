class Solution:
    def exist(self, board, word):
        rows, cols = len(board), len(board[0])

        def dfs(r, c, i):
            if i == len(word):
                return True
            
            if (r < 0 or c < 0 or r >= rows or c >= cols or 
                board[r][c] != word[i]):
                return False
            
            temp = board[r][c]
            board[r][c] = "#"  # mark visited
            
            found = (dfs(r+1, c, i+1) or
                     dfs(r-1, c, i+1) or
                     dfs(r, c+1, i+1) or
                     dfs(r, c-1, i+1))
            
            board[r][c] = temp  # backtrack
            return found

        for r in range(rows):
            for c in range(cols):
                if dfs(r, c, 0):
                    return True
        
        return False

##############################################################################################################################################################


BACKTRACKING



class Solution:
    def exist(self, board: list[list[str]], word: str) -> bool:

        rows = len(board)
        cols = len(board[0])

        # Initially every cell is unvisited
        visited = [[False] * cols for _ in range(rows)]

        # LEFT, RIGHT, UP, DOWN
        directions = [
            (0, -1),
            (0, 1),
            (-1, 0),
            (1, 0)
        ]

        def backtrack(row, col, index):

            # 1. Boundary check
            if row < 0 or row >= rows or col < 0 or col >= cols:
                return False

            # 2. Already visited?
            if visited[row][col]:
                return False

            # 3. Does current cell contain required letter?
            if board[row][col] != word[index]:
                return False

            # 4. Choose this cell
            visited[row][col] = True

            # 5. Is this the LAST letter?
            if index == len(word) - 1:
                return True

            # 6. Explore all 4 directions
            for dr, dc in directions:

                nr = row + dr
                nc = col + dc

                # Explore the neighbor
                if backtrack(nr, nc, index + 1):
                    return True

            # 7. All directions failed
            # Undo the current choice
            visited[row][col] = False

            return False

        # Try every cell as a starting point
        for row in range(rows):
            for col in range(cols):

                if backtrack(row, col, 0):
                    return True

        return False
