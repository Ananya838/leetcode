class Solution:
    def backspaceCompare(self, s: str, t: str) -> bool:
        stack1 = []
        stack2 = []
        if len(s)!=len(t):
            return False
        for i in range(len(s)):
            if s[i]=='#':
                stack1.pop()
            else:
                stack1.append(s[i])
            if t[i]=='#':
                stack2.pop()
            else:
                stack2.append(t[i])
        return stack1==stack2
    
        
