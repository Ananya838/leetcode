class Solution:
    def sortArray(self, nums: List[int]) -> List[int]:
        def mergesort(l,h):
            mid = (l+h)//2
            if l<h:
                mergesort(l,mid)
                mergesort(mid+1,h)
                merge(l,mid,h)

        def merge(l,mid,h):

            temp = []
            i = l
            j = mid+1
 
            while i<=mid and j<=h:
                if nums[i]<nums[j]:
                    temp.append(nums[i])
                    i+=1
                else:
                    temp.append(nums[j])
                    j+=1
               
            while i<=mid:
                temp.append(nums[i])
                i+=1
               
            while j<=h:
                temp.append(nums[j])
                j+=1
      
            for i in range(len(temp)):
                nums[l+i] = temp[i]
           
        mergesort(0,len(nums)-1)

        return nums
